{
  "name": "fhir-controller-cli",
  "version": "1.5.1",
  "description": "FHIR Controller CLI utilities.",
  "type": "module",
  "bin": {
    "fhir-controller": "./build/bin/fhir-controller.js",
    "fhir-controller-mcp": "./build/bin/fhir-controller-mcp.js"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "clean": "rm -rf ./build",
    "typecheck": "tsc",
    "compile": "tsc -p tsconfig.build.json && chmod +x ./build/bin/*",
    "copy-files": "mkdir -p build/assets && cp -R src/assets/ build/assets/",
    "build": "npm run typecheck && npm run clean && npm run compile && npm run copy-files",
    "prepack": "npm run build",
    "package": "npm run build && npm pack",
    "test": "npm run typecheck && vitest run",
    "test-watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/preston/fhir-controller-cli.git"
  },
  "keywords": [
    "Clinical",
    "Quality",
    "Language",
    "CQL",
    "CDS",
    "FHIR",
    "cql",
    "HAPI",
    "CLI"
  ],
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/preston/fhir-controller-cli/issues"
  },
  "homepage": "https://github.com/preston/fhir-controller-cli#README",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.19.0",
    "commander": "^15.0.0",
    "csv-parser": "^3.2.1",
    "stream-chain": "^4.2.5",
    "stream-json": "^3.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/fhir": "^0.0.44",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
